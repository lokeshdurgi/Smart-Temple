{
  "name": "appium-android-mobile-e2e-framework",
  "version": "1.0.0",
  "description": "Enterprise Production-Ready E2E Appium 2.x Mobile Automation Framework for Android Applications",
  "main": "index.js",
  "scripts": {
    "test": "mocha --config .mocharc.json",
    "test:emulator": "DEVICE_TYPE=emulator mocha --config .mocharc.json",
    "test:real": "DEVICE_TYPE=real mocha --config .mocharc.json",
    "test:apk": "EXECUTION_MODE=apk mocha --config .mocharc.json",
    "test:installed": "EXECUTION_MODE=installed mocha --config .mocharc.json",
    "test:smart": "SMART_TESTING=true mocha tests/mobile-forms.test.js --config .mocharc.json"
  },
  "keywords": [
    "appium",
    "appium2",
    "uiautomator2",
    "android",
    "mobile-automation",
    "mocha",
    "chai",
    "exceljs",
    "mochawesome",
    "winston"
  ],
  "author": "Senior Mobile QA Automation Architect",
  "license": "MIT",
  "dependencies": {
    "@appium/relaxed-caps": "^1.0.0",
    "appium": "^2.11.0",
    "appium-uiautomator2-driver": "^3.7.0",
    "chai": "^4.3.10",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "mocha": "^10.4.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "webdriverio": "^8.36.0",
    "winston": "^3.13.0"
  }
}
