{
  "diff": true,
  "extension": ["js"],
  "package": "./package.json",
  "reporter": "mochawesome",
  "reporter-option": [
    "reportDir=reports/html",
    "reportFilename=Mobile_E2E_Test_Report",
    "quiet=false",
    "overwrite=true",
    "html=true",
    "json=true"
  ],
  "slow": "100",
  "timeout": "120000",
  "ui": "bdd",
  "spec": ["tests/**/*.test.js"]
}
