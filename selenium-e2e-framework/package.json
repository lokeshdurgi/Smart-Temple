{
  "name": "selenium-react-e2e-framework",
  "version": "1.0.0",
  "description": "Enterprise Production-Ready E2E Selenium WebDriver Automation Framework for React Applications",
  "main": "index.js",
  "scripts": {
    "test": "mocha --config .mocharc.json",
    "test:chrome": "CROSS_BROWSER=chrome mocha --config .mocharc.json",
    "test:firefox": "CROSS_BROWSER=firefox mocha --config .mocharc.json",
    "test:edge": "CROSS_BROWSER=edge mocha --config .mocharc.json",
    "test:headless": "HEADLESS=true mocha --config .mocharc.json",
    "test:dynamic": "DYNAMIC_SCAN=true mocha tests/dynamic-discovery.test.js --config .mocharc.json",
    "test:parallel": "mocha --parallel --config .mocharc.json"
  },
  "keywords": [
    "selenium",
    "webdriver",
    "mocha",
    "chai",
    "react",
    "e2e",
    "automation-framework",
    "exceljs",
    "mochawesome"
  ],
  "author": "Senior QA Automation Architect",
  "license": "MIT",
  "dependencies": {
    "chai": "^4.3.10",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "mocha": "^10.4.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "selenium-webdriver": "^4.20.0",
    "winston": "^3.13.0"
  }
}
